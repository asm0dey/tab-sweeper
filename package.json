{
  "name": "tab-sweeper",
  "description": "Closes tabs you have not looked at in a while. Keeps pinned tabs and Zen Essentials.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chromium": "wxt -b chromium",
    "dev:brave": "wxt -b brave",
    "dev:zen": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "wxt prepare && tsc --noEmit",
    "test": "bun test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.5"
  },
  "license": "0BSD"
}
